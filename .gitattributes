# Force LF line endings for Unix scripts and configs
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.list text eol=lf
*.hook.chroot text eol=lf
*.hook.binary text eol=lf
*.service text eol=lf
*.cfg text eol=lf
*.js text eol=lf
config/includes.chroot/usr/lib/katu/qa-live-smoke text eol=lf
*.desktop text eol=lf
*.qml text eol=lf
*.script text eol=lf
*.plymouth text eol=lf
*.colors text eol=lf

# Windows docs can use CRLF
*.md text eol=crlf

# Binary files
*.iso binary
*.png binary
*.jpg binary
*.svg binary
*.deb binary
