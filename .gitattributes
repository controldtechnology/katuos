# Force LF line endings for Unix scripts and configs
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.list text eol=lf
*.hook.chroot text eol=lf
*.desktop text eol=lf
*.qml text eol=lf
*.script text eol=lf
*.plymouth text eol=lf
*.colors text eol=lf

# Windows docs can use CRLF
*.md text eol=crlf

# Binary files
*.iso binary
*.png binary
*.jpg binary
*.svg binary
*.deb binary