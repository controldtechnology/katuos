#!/bin/bash
set -e

chmod +x /usr/bin/katu-welcome
chmod +x /usr/lib/katu-welcome/main.py

# Criar flag de primeiro boot (removida pelo katu-welcome após primeiro uso)
if [ ! -f /etc/katu-firstboot ]; then
    touch /etc/katu-firstboot
    chmod 644 /etc/katu-firstboot
fi

if command -v update-desktop-database &>/dev/null; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
fi

#DEBHELPER#
exit 0
