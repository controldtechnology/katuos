#!/usr/bin/python3 -I
"""Polkit authorizes; systemd keeps the transaction alive across GUI updates."""
import fcntl
import json
import re
import os
from pathlib import Path
import signal
import select
import subprocess
import sys
import time
sys.path.insert(0, '/usr/lib/katu-update')
from backend import STATE, HELPER, UNIT, SAFE_NAME, UpdateError, make_plan, preflight, run, validate_sources, verify_versions


def write_json(name, value):
    STATE.mkdir(mode=0o755, parents=True, exist_ok=True)
    temp = STATE / (name + '.tmp')
    with temp.open('w') as stream:
        json.dump(value, stream, ensure_ascii=False)
        stream.flush()
        os.fsync(stream.fileno())
    temp.chmod(0o644)
    temp.replace(STATE / name)


def refresh():
    validate_sources()
    STATE.mkdir(mode=0o755, parents=True, exist_ok=True)
    refresh_lock = (STATE / 'refresh.lock').open('w')
    try:
        fcntl.flock(refresh_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise UpdateError('Outra verificação está em andamento. Aguarde e tente novamente.')
    try:
        run(['/usr/bin/apt-get', '-o', 'APT::Update::Error-Mode=any',
             '-o', 'Acquire::AllowInsecureRepositories=false',
             '-o', 'Acquire::AllowDowngradeToInsecureRepositories=false', 'update'], timeout=600)
        write_json('check.json', dict(ok=True, time=time.time()))
    except Exception:
        write_json('check.json', dict(ok=False, time=time.time(), error='Falha ao atualizar índices autenticados.'))
        raise


def apt_phase(args, record, cancellation=None):
    """Only numeric progress and validated package names reach persistent status."""
    diagnostic = STATE / 'apt-error.tmp'
    with diagnostic.open('w') as errors:
      os.chmod(diagnostic, 0o600)
      process = subprocess.Popen(args + ['-o', 'APT::Status-Fd=1'], stdout=subprocess.PIPE,
                                 stderr=errors, env={**os.environ, 'LC_ALL': 'C', 'DEBIAN_FRONTEND': 'noninteractive'})
    os.set_blocking(process.stdout.fileno(), False)
    pending = b''
    while process.poll() is None:
        if cancellation and cancellation():
            process.terminate()
            process.wait()
            raise UpdateError('Download cancelado. Nenhum pacote foi instalado.')
        readable, _, _ = select.select([process.stdout], [], [], 0.5)
        if not readable:
            continue
        pending += os.read(process.stdout.fileno(), 65536)
        lines = pending.split(b'\n')
        pending = lines.pop()
        for raw in lines:
            parts = raw.decode('utf-8', errors='replace').split(':')
            if len(parts) >= 3 and parts[0] in ('dlstatus', 'pmstatus'):
                try:
                    record['percent'] = max(0, min(100, float(parts[2])))
                    record['current'] = parts[1] if SAFE_NAME.fullmatch(parts[1]) else ''
                    write_json('status.json', record)
                except ValueError:
                    pass
    if process.returncode:
        safe = []
        for line in diagnostic.read_text(errors='replace').splitlines()[-20:]:
            if line.startswith(('E:', 'W:', 'dpkg:', 'dpkg-deb:')):
                line = re.sub(r'https?://\S+', '[endereço removido]', line)
                line = re.sub(r'(?i)(password|token|secret|api[_-]?key)=\S+', r'\1=[removido]', line)
                safe.append(line[:400])
        detail = ' '.join(safe)
        raise UpdateError('Falha do APT durante ' + record['phase'] + '.' + ((' ' + detail) if detail else ' Verifique rede, assinatura, espaço e estado do dpkg.'))


def transaction(digest, selected):
    STATE.mkdir(mode=0o755, parents=True, exist_ok=True)
    lock = (STATE / 'transaction.lock').open('w')
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    record = dict(id=digest, started=time.time(), phase='validating', ok=False, packages=[])
    write_json('status.json', record)
    cancelled = False

    def cancel(signum, frame):
        nonlocal cancelled
        cancelled = True

    signal.signal(signal.SIGUSR1, cancel)
    try:
        plan = make_plan(selected)
        if plan['digest'] != digest:
            raise UpdateError('A lista mudou. Verifique novamente e autorize o novo plano.')
        preflight(plan)
        record['packages'] = plan['packages']
        specs = [p['name'] + '=' + p['version'] for p in plan['packages']]
        if not specs:
            raise UpdateError('Não há pacotes neste plano.')
        base = ['/usr/bin/apt-get', '-y', '--no-remove', '--no-install-recommends',
                '-o', 'APT::Get::AllowUnauthenticated=false',
                '-o', 'Acquire::AllowInsecureRepositories=false',
                '-o', 'Dpkg::Options::=--force-confold']
        record['phase'] = 'downloading'
        write_json('status.json', record)
        apt_phase(base + ['--download-only', 'install'] + specs, record, lambda: cancelled)
        if cancelled:
            raise UpdateError('Download cancelado.')
        if make_plan(selected)['digest'] != digest:
            raise UpdateError('O plano mudou durante o download. Verifique novamente.')
        record['phase'] = 'installing'
        write_json('status.json', record)
        apt_phase(base + ['--no-download', 'install'] + specs, record)
        automatic = [p['name'] for p in plan['packages'] if p['automatic']]
        if automatic:
            run(['/usr/bin/apt-mark', 'auto'] + automatic)
        record['phase'] = 'verifying'
        write_json('status.json', record)
        verify_versions(plan)
        record.update(ok=True, phase='complete', reboot=Path('/run/reboot-required').exists() or plan['critical'])
    except Exception as exc:
        record.update(ok=False, failed_phase=record['phase'], error_type=type(exc).__name__, phase='failed', error=str(exc) if isinstance(exc, UpdateError) else 'Transação interrompida ou indisponível; consulte o journal.')
    finally:
        record['finished'] = time.time()
        (STATE / 'apt-error.tmp').unlink(missing_ok=True)
        write_json('status.json', record)
        with (STATE / 'history.jsonl').open('a') as stream:
            stream.write(json.dumps(record, ensure_ascii=False) + '\n')
            stream.flush()
            os.fsync(stream.fileno())
    return 0 if record['ok'] else 1


def main():
    if os.geteuid() != 0:
        raise UpdateError('Esta ação requer autenticação administrativa.')
    action = sys.argv[1] if len(sys.argv) > 1 else ''
    if action == 'refresh' and len(sys.argv) == 2:
        refresh()
        return 0
    if action == 'start' and len(sys.argv) >= 4:
        digest, selected = sys.argv[2], sys.argv[3:]
        if make_plan(selected)['digest'] != digest:
            raise UpdateError('Plano alterado. Faça nova verificação.')
        run(['/usr/bin/systemd-run', '--unit=' + UNIT, '--collect', '--property=Type=exec',
             '--property=TimeoutStopSec=infinity', HELPER, 'apply', digest] + selected)
        return 0
    if action == 'apply' and len(sys.argv) >= 4:
        return transaction(sys.argv[2], sys.argv[3:])
    if action == 'cancel' and len(sys.argv) == 2:
        run(['/usr/bin/systemctl', 'kill', '--kill-whom=main', '--signal=SIGUSR1', UNIT])
        return 0
    raise UpdateError('Ação inválida.')


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception as exc:
        print(str(exc) if isinstance(exc, UpdateError) else 'Operação indisponível.', file=sys.stderr)
        sys.exit(1)
