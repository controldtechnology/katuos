#!/bin/bash
export PYTHONPATH="/usr/lib/python3/dist-packages:${PYTHONPATH:-}"
export QT_QPA_PLATFORMTHEME=kde
LOG="/tmp/katu-store.log"
python3 "/usr/lib/katu-store/main.py" "$@" 2>"$LOG"
ret=$?
if [ $ret -ne 0 ]; then
    ERRMSG=$(tail -5 "$LOG" 2>/dev/null | head -c 400)
    kdialog --error "Erro ao iniciar katu-store.\n\n${ERRMSG:-Erro desconhecido}\n\nLog completo: $LOG" 2>/dev/null ||     zenity --error --text="Erro ao iniciar katu-store. Log: $LOG" 2>/dev/null || true
fi
exit $ret
