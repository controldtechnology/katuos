#!/bin/bash
# Hook: Instala dependências Python para o ecossistema Katu OS
set -e

export DEBIAN_FRONTEND=noninteractive

echo "[KATU] Instalando dependências do ecossistema Katu..."

# Python 3 + Qt bindings (katu-core e todos os apps PyQt5)
apt-get install -y \
    python3 \
    python3-pyqt5 \
    python3-requests \
    rsync \
    2>/dev/null || true

# Garante que o módulo dbus está disponível (para notificações KDE)
apt-get install -y python3-dbus libnotify-bin 2>/dev/null || true

# Compila bytecode Python para os módulos katu_core
if [ -d /usr/lib/python3/dist-packages/katu_core ]; then
    python3 -m compileall -q /usr/lib/python3/dist-packages/katu_core/ 2>/dev/null || true
fi

echo "[KATU] Dependências do ecossistema instaladas."
