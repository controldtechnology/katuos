#!/bin/bash
# Hook: Aplicar tema Amazônia Dark no KDE Plasma

set -Eeuo pipefail

echo ">>> [Katu Hook] Configurando tema Plasma — Amazônia Dark..."

SKEL_CONFIG="/etc/skel/.config"
SKEL_LOCAL="/etc/skel/.local/share"

mkdir -p "${SKEL_CONFIG}/plasma-workspace/env"
mkdir -p "${SKEL_LOCAL}/plasma/look-and-feel"

# kdeglobals — paleta Amazônia Dark
cat > "${SKEL_CONFIG}/kdeglobals" << 'EOF'
[General]
ColorScheme=KatuDark
fixed=Noto Mono,10,-1,5,50,0,0,0,0,0
font=Noto Sans,10,-1,5,50,0,0,0,0,0
menuFont=Noto Sans,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Noto Sans,8,-1,5,50,0,0,0,0,0
toolBarFont=Noto Sans,10,-1,5,50,0,0,0,0,0

[Icons]
Theme=breeze-dark

[KDE]
LookAndFeelPackage=org.katuos.desktop
SingleClick=false
widgetStyle=Breeze

[Locale]
Country=BR
Language=pt_BR
EOF

# plasmarc — tema de widgets
cat > "${SKEL_CONFIG}/plasmarc" << 'EOF'
[Theme]
name=default
EOF

# Wallpaper padrão Amazônia
WALLPAPER_PATH="/usr/share/wallpapers/katu/contents/images/katu-amazonia-4k.png"

cat > "${SKEL_CONFIG}/plasma-org.kde.plasma.desktop-appletsrc" << EOF
[Containments][1][Wallpaper][org.kde.image][General]
Image=${WALLPAPER_PATH}
FillMode=2
EOF

# kscreenlockerrc — lock screen com wallpaper Katu
cat > "${SKEL_CONFIG}/kscreenlockerrc" << EOF
[Greeter][Wallpaper][org.kde.image][General]
Image=${WALLPAPER_PATH}
FillMode=2
EOF

echo ">>> [Katu Hook] Tema Amazônia Dark aplicado."
