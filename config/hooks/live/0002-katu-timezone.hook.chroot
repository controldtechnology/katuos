#!/bin/bash
# Hook: Configurar fuso horário padrão

set -Eeuo pipefail

echo ">>> [Katu Hook] Configurando fuso horário..."

# Definir fuso padrão (pode ser alterado no instalador)
ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
echo "America/Sao_Paulo" > /etc/timezone

echo ">>> [Katu Hook] Fuso horário configurado: America/Sao_Paulo"
