#!/bin/bash
# Hook: Configurações KDE Plasma adicionais via kwriteconfig5

set -Eeuo pipefail

echo ">>> [Katu Hook] Aplicando configurações KDE adicionais..."

SKEL_CONFIG="/etc/skel/.config"
mkdir -p "${SKEL_CONFIG}"

# kglobalshortcutsrc — atalhos globais PT-BR
cat > "${SKEL_CONFIG}/kglobalshortcutsrc" << 'EOF'
[kwin]
Kill Window=Meta+Ctrl+Escape,Meta+Ctrl+Escape,Fechar janela forçadamente
Switch One Desktop Down=Meta+Ctrl+Down,Meta+Ctrl+Down,Área de trabalho abaixo
Switch One Desktop Up=Meta+Ctrl+Up,Meta+Ctrl+Up,Área de trabalho acima
Toggle Overview=Meta+W,Meta+W,Ver todas as janelas
Window Quick Tile Bottom=Meta+Down,Meta+Down,Encaixar janela abaixo
Window Quick Tile Left=Meta+Left,Meta+Left,Encaixar janela à esquerda
Window Quick Tile Right=Meta+Right,Meta+Right,Encaixar janela à direita
Window Quick Tile Top=Meta+Up,Meta+Up,Encaixar janela acima
Window Close=Alt+F4,Alt+F4,Fechar janela
Window Fullscreen=Meta+F11,Meta+F11,Tela cheia

[plasmashell]
Show Dashboard=Meta+D,Meta+D,Mostrar área de trabalho
activate task manager entry 1=Meta+1,Meta+1,Ativar entrada 1 da barra de tarefas
activate task manager entry 2=Meta+2,Meta+2,Ativar entrada 2 da barra de tarefas
activate task manager entry 3=Meta+3,Meta+3,Ativar entrada 3 da barra de tarefas
EOF

# Plasma notifications — PT-BR
cat > "${SKEL_CONFIG}/plasmanotifyrc" << 'EOF'
[Notifications]
PopupPosition=BottomRight
PopupTimeout=5000
EOF

# spectacle — ferramenta de captura de tela
cat > "${SKEL_CONFIG}/spectaclerc" << 'EOF'
[General]
clipboardGroup=PostScreenshotCopyImage
launchAction=UseLastUsedCapturemode
onLaunchWithToggle=true
rememberLastRectangular=true
useReleaseToCapture=true

[ImageSave]
defaultSaveImageLocation=/home/$USER/Imagens
saveImageFormat=PNG

[VideoSave]
defaultSaveVideoLocation=/home/$USER/Imagens
EOF

# krunnerrc — configuração do lançador rápido
cat > "${SKEL_CONFIG}/krunnerrc" << 'EOF'
[General]
FreeFloating=false
HistoryEnabled=true
RetainPriorSearch=true

[Plugins]
baloosearchEnabled=true
calculatorEnabled=true
krunner_appstreamEnabled=true
krunner_bookmarksrunnerEnabled=false
krunner_recentdocumentsEnabled=true
krunner_sessionsEnabled=true
krunner_shellEnabled=true
krunner_systemsettingsEnabled=true
krunner_webshortcutsEnabled=true
EOF

# Tema de notificação do Plasma (usar padrão com accent verde)
cat > "${SKEL_CONFIG}/plasmarc" << 'EOF'
[Theme]
name=default

[General]
showToolTips=true
EOF

# baloofilerc — indexação de arquivos (mais leve)
cat > "${SKEL_CONFIG}/baloofilerc" << 'EOF'
[Basic Settings]
Indexing-Enabled=false

[General]
dbVersion=2
first run=false
EOF

# Wallpaper padrão via plasma-org.kde.plasma.desktop-appletsrc
WALLPAPER="/usr/share/wallpapers/katu/contents/images/katu-amazonia-4k.png"
cat > "${SKEL_CONFIG}/plasma-org.kde.plasma.desktop-appletsrc" << EOF
[Containments][1][Wallpaper][org.kde.image][General]
Image=${WALLPAPER}
ImageDefault=${WALLPAPER}

[Containments][2][Wallpaper][org.kde.image][General]
Image=${WALLPAPER}
ImageDefault=${WALLPAPER}
EOF

# KDE look-and-feel e cores
cat > "${SKEL_CONFIG}/kdeglobals" << 'EOF'
[KDE]
LookAndFeelPackage=org.katuos.desktop
SingleClick=false

[General]
AccentColor=0,200,83

[Colors:Button]
BackgroundNormal=30,50,30
ForegroundNormal=248,249,250

[Colors:Window]
BackgroundNormal=20,35,20
ForegroundNormal=248,249,250
EOF

# Autostart: aplicar wallpaper e lançar Calamares no live mode
mkdir -p "${SKEL_CONFIG}/autostart"
cat > "${SKEL_CONFIG}/autostart/katu-live-start.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=Katu OS Live Setup
Exec=/usr/bin/katu-live-start
Terminal=false
X-GNOME-Autostart-enabled=true
EOF

# Permissão para Calamares rodar via polkit sem senha no live
mkdir -p /etc/polkit-1/rules.d
cat > /etc/polkit-1/rules.d/49-katu-calamares.rules << 'EOF'
polkit.addRule(function(action, subject) {
    if (action.id === "com.github.calamares.calamares.pkexec.run" &&
        subject.user === "katu" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
EOF

# Tornar katu-live-start executável
chmod +x /usr/bin/katu-live-start 2>/dev/null || true

echo ">>> [Katu Hook] Configurações KDE aplicadas."
