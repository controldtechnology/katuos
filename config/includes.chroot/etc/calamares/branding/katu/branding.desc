# Katu OS — Calamares branding
# Paleta oficial amostrada dos assets: #041F16 / #0F7B43 / #E0B146

componentName: katu

strings:
    productName:         "Katu OS"
    version:             "1.0"
    shortVersion:        "1.0"
    versionedName:       "Katu OS 1.0"
    shortProductName:    "Katu OS"
    bootloaderEntryName: "Katu OS"
    productUrl:          "https://katuos.com.br"
    supportUrl:          "https://katuos.com.br/suporte"
    knownIssuesUrl:      "https://katuos.com.br/problemas-conhecidos"
    releaseNotesUrl:     "https://katuos.com.br/notas/1.0"

    # Textos da tela de instalação
    welcome:
        title:       "Bem-vindo ao Katu OS!"
        subtitle:    "Livre. Brasileiro. Para todos."
        description: "Vamos instalar o Katu OS no seu computador.\nO processo é simples e leva apenas alguns minutos."

    install:
        title:    "Instalando o Katu OS…"
        subtitle: "O tempo varia conforme o computador.\nMantenha o computador ligado até a conclusão."

    finished:
        title:       "Instalação concluída!"
        restartNow:  "Reiniciar agora"
        restartLater: "Continuar usando o sistema live"
        description: "O Katu OS foi instalado com sucesso! Remova o pendrive e reinicie."

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:             "show.qml"
slideshowAPI:          2

style:
    sidebarBackground:       "#041F16"
    sidebarText:             "#C2CBBF"
    sidebarTextSelect:       "#F4F1E2"
    sidebarTextHighlight:    "#E0B146"
    sidebarSelectionColor:   "#10462B"
