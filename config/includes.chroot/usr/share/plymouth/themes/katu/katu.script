// Katu OS Plymouth Theme Script
// Usa: logo.png, spinner.png, progress-dot.png

// Fundo escuro com toque verde
Window.SetBackgroundTopColor(0.063, 0.094, 0.063);    // #102018 verde muito escuro
Window.SetBackgroundBottomColor(0.039, 0.063, 0.039); // #0a100a quase preto

// === Logo central ===
logo.image = Image("logo.png");
logo.sprite = Sprite();
logo.sprite.SetImage(logo.image);
logo.x = Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 20;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetZ(10);

// === Spinner de carregamento ===
spinner.image  = Image("spinner.png");
spinner.frames = 8;  // número de frames do sprite sheet
spinner.frame  = 0;
spinner.sprite = Sprite();
spinner.x = Window.GetX() + Window.GetWidth()  / 2 - spinner.image.GetWidth()  / 2;
spinner.y = logo.y + logo.image.GetHeight() + 30;
spinner.sprite.SetX(spinner.x);
spinner.sprite.SetY(spinner.y);
spinner.sprite.SetZ(10);

// === Dots de progresso ===
DOT_COUNT = 5;
DOT_SPACING = 16;
dot_total_width = DOT_COUNT * DOT_SPACING;
dot_start_x = Window.GetX() + Window.GetWidth() / 2 - dot_total_width / 2;
dot_y = spinner.y + spinner.image.GetHeight() + 20;

for (i = 0; i < DOT_COUNT; i++) {
    dot[i].image  = Image("progress-dot.png");
    dot[i].sprite = Sprite();
    dot[i].sprite.SetImage(dot[i].image);
    dot[i].sprite.SetX(dot_start_x + i * DOT_SPACING);
    dot[i].sprite.SetY(dot_y);
    dot[i].sprite.SetZ(10);
    dot[i].sprite.SetOpacity(0.3);
}

// === Animação de progresso ===
active_dot = 0;

fun progress_callback(duration, progress) {
    new_active = Math.Int(progress * DOT_COUNT);
    if (new_active != active_dot) {
        // Apagar dot anterior
        if (active_dot < DOT_COUNT) {
            dot[active_dot].sprite.SetOpacity(0.4);
        }
        active_dot = new_active;
        // Acender dot atual
        if (active_dot < DOT_COUNT) {
            dot[active_dot].sprite.SetOpacity(1.0);
        }
    }
}

Plymouth.SetBootProgressFunction(progress_callback);

// === Animação do spinner (framerate ~10fps) ===
frame_counter = 0;

fun refresh_callback() {
    frame_counter++;
    if (Math.Int(frame_counter % 3) == 0) {
        spinner.frame = (spinner.frame + 1) % spinner.frames;
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

// Silenciar mensagens técnicas
fun message_callback(text) { }
Plymouth.SetMessageFunction(message_callback);
