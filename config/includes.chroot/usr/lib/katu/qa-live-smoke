#!/bin/bash
set -Eeuo pipefail
exec > /dev/ttyS0 2>&1
export SYSTEMD_COLORS=0 SYSTEMD_PAGER=cat SYSTEMD_PAGERSECURE=0
diagnose() {
    echo "KATU_QA_FAIL:${nonce:-unknown}"
    echo '--- SDDM configuration ---'
    for config in /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
        [ -f "$config" ] && { echo "### $config"; cat "$config"; }
    done
    echo '--- Available sessions ---'
    find /usr/share/wayland-sessions /usr/share/xsessions -maxdepth 1 -type f -print 2>/dev/null || true
    systemctl show sddm -p ActiveState -p SubState -p ExecMainStatus --no-pager || true
    journalctl -b -u sddm -n 60 --no-pager -o cat || true
    journalctl -b --no-pager -o cat | grep -Ei 'sddm|plasma|autologin|session' | tail -100 || true
    findmnt / || true
    pgrep -a plasmashell || true
    loginctl list-sessions --no-legend || true
}
trap diagnose ERR
trap 'echo "KATU_QA_INTERRUPTED:${nonce:-unknown}"; diagnose' TERM INT
grep -qw 'boot=live' /proc/cmdline
nonce=$(sed -n 's/.*katu.qa=\([a-f0-9]*\).*/\1/p' /proc/cmdline)
[[ $nonce =~ ^[a-f0-9]{32}$ ]]
echo "KATU_QA_START:$nonce"
id katu
systemctl is-enabled katu-live-autologin.service
systemctl show katu-live-autologin.service -p ActiveState -p SubState -p ExecMainStatus --no-pager || true
for attempt in $(seq 1 110); do
    if (( attempt % 10 == 0 )); then
        echo "KATU_QA_WAIT:$attempt sddm=$(systemctl is-active sddm || true) plasma=$(pgrep -u katu -x plasmashell || true)"
    fi
    if systemctl is-active --quiet sddm && pgrep -u katu -x plasmashell >/dev/null; then
        uid=$(id -u katu)
        if runuser -u katu -- env XDG_RUNTIME_DIR="/run/user/$uid" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            busctl --user status org.kde.plasmashell >/dev/null 2>&1; then
            findmnt -n -t overlay /
            test -r /run/live/medium/live/filesystem.squashfs
            test -x /usr/bin/calamares
            echo "KATU_QA_PASS:$nonce:systemd:sddm:plasmashell:overlay"
            exit 0
        fi
    fi
    sleep 5
done
diagnose
exit 1
