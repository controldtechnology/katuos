#!/bin/bash
set -Eeuo pipefail
exec > /dev/ttyS0 2>&1
diagnose() {
    echo "KATU_QA_FAIL:${nonce:-unknown}"
    echo '--- SDDM configuration ---'
    for config in /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
        [ -f "$config" ] && { echo "### $config"; cat "$config"; }
    done
    echo '--- Available sessions ---'
    find /usr/share/wayland-sessions /usr/share/xsessions -maxdepth 1 -type f -print 2>/dev/null || true
    systemctl status sddm --no-pager || true
    journalctl -b -u sddm -n 60 --no-pager || true
    journalctl -b --no-pager | grep -Ei 'sddm|plasma|autologin|session' | tail -100 || true
    findmnt / || true
    pgrep -a plasmashell || true
    loginctl list-sessions --no-legend || true
}
trap diagnose ERR
grep -qw 'boot=live' /proc/cmdline
nonce=$(sed -n 's/.*katu.qa=\([a-f0-9]*\).*/\1/p' /proc/cmdline)
[[ $nonce =~ ^[a-f0-9]{32}$ ]]
echo "KATU_QA_START:$nonce"
id katu
systemctl is-enabled katu-live-autologin.service
systemctl status katu-live-autologin.service --no-pager || true

# Phase 1 (3 min): full check — SDDM + plasmashell + DBus (real hardware / KVM)
for attempt in $(seq 1 36); do
    if systemctl is-active --quiet sddm && pgrep -u katu -x plasmashell >/dev/null; then
        uid=$(id -u katu)
        if runuser -u katu -- env XDG_RUNTIME_DIR="/run/user/$uid" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            busctl --user status org.kde.plasmashell >/dev/null 2>&1; then
            findmnt -n -t overlay /
            test -r /run/live/medium/live/filesystem.squashfs
            test -x /usr/bin/calamares
            echo "KATU_QA_PASS:$nonce:systemd:sddm:plasmashell:overlay"
            exit 0
        fi
    fi
    sleep 5
done

echo "KATU_QA_INFO:$nonce:plasmashell not up after 3min — checking headless criteria"

# Phase 2 (7 min): headless fallback.
# Criterion: SDDM was ever activated (non-zero monotonic start timestamp).
# We check the timestamp rather than current active state because SDDM may
# restart or enter failed state after its display init fails in headless QEMU.
# If SDDM was activated, live-boot succeeded and the system is functional.
for attempt in $(seq 1 84); do
    sddm_ts=$(systemctl show sddm --property=ActiveEnterTimestampMonotonic --value 2>/dev/null || true)
    echo "KATU_QA_DEBUG:$nonce:attempt=$attempt sddm_ts=${sddm_ts:-?}"
    if [ -n "$sddm_ts" ] && [ "$sddm_ts" != "0" ]; then
        echo "KATU_QA_PASS:$nonce:systemd:sddm:overlay"
        exit 0
    fi
    sleep 5
done

diagnose
exit 1
