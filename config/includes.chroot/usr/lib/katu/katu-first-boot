#!/usr/bin/env python3
"""
Katu OS First Boot — registra instalação e configura o sistema instalado.
Executado uma única vez após a instalação pelo katu-firstboot.service.
"""
import json
import os
import subprocess
import urllib.request
from pathlib import Path

STATS_URL = "https://katuos.com.br/api/stats"
MARKER = Path("/var/lib/katu/.first-boot-done")


def send_install_stat():
    try:
        version = "1.0"
        try:
            with open("/etc/katu-release") as f:
                for line in f:
                    if line.startswith("VERSION="):
                        version = line.strip().split("=", 1)[1].strip('"')
        except Exception:
            pass

        payload = json.dumps({
            "event": "install",
            "version": version,
            "arch": os.uname().machine,
        }).encode()
        req = urllib.request.Request(
            STATS_URL,
            data=payload,
            method="POST",
            headers={
                "Content-Type": "application/json",
                "User-Agent": f"KatuOS/{version}"
            }
        )
        urllib.request.urlopen(req, timeout=10)
    except Exception:
        pass


def configure_system():
    cmds = [
        ["systemctl", "enable", "NetworkManager"],
        ["systemctl", "enable", "sddm"],
        ["update-initramfs", "-u", "-k", "all"],
    ]
    for cmd in cmds:
        try:
            subprocess.run(cmd, check=False, capture_output=True)
        except Exception:
            pass


def main():
    if MARKER.exists():
        return

    MARKER.parent.mkdir(parents=True, exist_ok=True)

    configure_system()
    send_install_stat()

    MARKER.touch()
    print("Katu OS: primeiro boot configurado com sucesso.")


if __name__ == "__main__":
    main()
