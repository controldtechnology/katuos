#!/bin/sh
set -eu

id katu >/dev/null
session=
for candidate in plasma.desktop plasmawayland.desktop; do
    if [ -f "/usr/share/wayland-sessions/$candidate" ]; then
        session=$candidate
        break
    fi
done
if [ -z "$session" ]; then
    for candidate in plasmax11.desktop plasma.desktop; do
        if [ -f "/usr/share/xsessions/$candidate" ]; then
            session=$candidate
            break
        fi
    done
fi
test -n "$session"
install -d -m 755 /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-katu-live-autologin.conf <<EOF
[Autologin]
User=katu
Session=$session
Relogin=false
EOF

# No Live, o welcome editorial é aberto uma única vez pelo katu-live-start.
# Desativar apenas para este usuário a entrada de first boot do desktop; ela
# continua habilitada no sistema instalado, onde o usuário novo vem de /etc/skel.
welcome_dir=/home/katu/.config/autostart
install -d -o katu -g katu -m 755 "$welcome_dir"
cat > "$welcome_dir/katu-welcome-firstboot.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Katu Welcome (First Boot)
Hidden=true
EOF
chown katu:katu "$welcome_dir/katu-welcome-firstboot.desktop"
