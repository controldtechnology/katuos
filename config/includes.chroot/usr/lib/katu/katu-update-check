#!/usr/bin/env python3
"""
Katu OS Update Center — verifica novas versões e notifica o usuário.
"""
import json
import os
import subprocess
import sys
import urllib.request
from pathlib import Path

CURRENT_VERSION = "1.0"
UPDATE_URL = "https://katuos.com.br/update.json"
STATS_URL = "https://katuos.com.br/api/stats"
VERSION_FILE = "/etc/katu-release"
LAST_CHECK_FILE = Path.home() / ".config" / "katu" / "last-update-check"


def get_current_version():
    try:
        with open(VERSION_FILE) as f:
            for line in f:
                if line.startswith("VERSION="):
                    return line.strip().split("=", 1)[1].strip('"')
    except Exception:
        pass
    return CURRENT_VERSION


def check_for_updates():
    try:
        req = urllib.request.Request(
            UPDATE_URL,
            headers={"User-Agent": f"KatuOS/{get_current_version()}"}
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read())
        latest = data.get("latest_version", "")
        current = get_current_version()
        if latest and latest != current:
            return data
    except Exception:
        pass
    return None


def send_stats(event="check"):
    """Envia estatística anônima (sem dados pessoais)."""
    try:
        payload = json.dumps({
            "event": event,
            "version": get_current_version(),
            "arch": os.uname().machine,
        }).encode()
        req = urllib.request.Request(
            STATS_URL,
            data=payload,
            method="POST",
            headers={
                "Content-Type": "application/json",
                "User-Agent": f"KatuOS/{get_current_version()}"
            }
        )
        urllib.request.urlopen(req, timeout=5)
    except Exception:
        pass


def notify(title, message, urgency="normal"):
    subprocess.Popen([
        "notify-send",
        "--app-name=Katu OS",
        f"--urgency={urgency}",
        "--icon=katu-logo",
        title,
        message
    ])


def main():
    # Marcar verificação
    LAST_CHECK_FILE.parent.mkdir(parents=True, exist_ok=True)

    # Enviar estatística (silencioso, sem dados pessoais)
    send_stats("check")

    # Verificar atualização
    update = check_for_updates()
    if update:
        latest = update.get("latest_version", "")
        notes = update.get("release_notes", "Nova versão disponível.")
        download = update.get("download_url", "https://katuos.com.br")
        notify(
            f"Katu OS {latest} disponível!",
            f"{notes}\nBaixe em: {download}",
            urgency="normal"
        )

    LAST_CHECK_FILE.write_text(str(__import__("time").time()))


if __name__ == "__main__":
    main()
